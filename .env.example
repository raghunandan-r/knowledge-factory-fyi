# Copy to .env (gitignored). The Makefile loads it for make pilot.

# Real pilot: the agent is claude-opus-5-5 on the Anthropic API.
ANTHROPIC_API_KEY=

# Smoke test with another model through OpenRouter's Anthropic-compatible endpoint.
# Use these instead of ANTHROPIC_API_KEY (leave that empty). Runs and the report go under
# data/runs/smoke-*, so they never count as pilot runs.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# KF_SMOKE_MODEL=particle-ai/particle-1:free

# Only if the openFDA fallback is used.
OPENFDA_API_KEY=
